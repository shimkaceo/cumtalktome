generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Influencer {
  id            String         @id @default(uuid())
  nombre        String
  urlDestino    String
  categoria     Categoria
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  linkVariants  LinkVariant[]
  analytics     AccessLog[]
  
  @@index([nombre])
  @@index([categoria])
}

model LinkVariant {
  id            String         @id @default(uuid())
  influencerId  String
  slug          String         @unique
  clickCount    Int            @default(0)
  isActive      Boolean        @default(true)
  archivedAt    DateTime?
  createdBy     String?
  // El ultimo clic. Con 21 dias sin clics el link caduca (server.js).
  lastClickAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  influencer    Influencer     @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  accessLogs    AccessLog[]
  clicksUnicos  ClickUnico[]
  
  @@index([slug])
  @@index([influencerId])
  @@index([createdBy])
}

model AccessLog {
  id            String         @id @default(uuid())
  variantId     String
  influencerId  String?
  ipAddress     String
  country       String?
  userAgent     String?
  ja3Hash       String?
  deviceType    String?
  referrer      String?
  timestamp     DateTime       @default(now())
  isBot         Boolean        @default(false)
  riskScore     Int            @default(0)
  
  variant       LinkVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  influencer    Influencer?    @relation(fields: [influencerId], references: [id])
  
  @@index([variantId])
  @@index([ipAddress])
  @@index([timestamp])
  @@index([isBot])
}

// Clics unicos por enlace e IP (los que cobran los clippers de Shimka Clips).
// La tabla la crea server.js al arrancar; esto solo la describe igual para que
// `prisma db push` no la borre.
model ClickUnico {
  id            String         @id
  variantId     String
  ipHash        String
  pais          String?
  createdAt     DateTime       @default(now())

  variant       LinkVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, ipHash])
  @@index([createdAt])
}

enum Categoria {
  FOTOGRAFIA
  ARTE
  LIFESTYLE
  MODA
  FITNESS
  MUSICA
  OTROS
}

model AdminUser {
  id            String         @id @default(uuid())
  username      String         @unique
  password      String
  createdAt     DateTime       @default(now())
  lastLogin     DateTime?
}
